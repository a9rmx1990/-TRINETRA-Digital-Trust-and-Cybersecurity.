# Generate a local value with: python -c 'import secrets; print(secrets.token_urlsafe(24))'
TRINETRA_ANALYST_KEY=

# Local model artifacts. See backend/models.example.json for the manifest.
TRINETRA_MODELS=

# Optional model server running on 127.0.0.1. Leave the port blank for local evidence reports.
TRINETRA_LOCAL_LLM_PORT=
TRINETRA_LOCAL_LLM_MODEL=
TRINETRA_COPILOT_AUTO=1
TRINETRA_COPILOT_TRANSCRIPT=0

# Optional infrastructure.
TRINETRA_REDIS_URL=
TRINETRA_ICE_SERVERS='[]'

# Agentic SOC defaults to read-only local operation.
TRINETRA_AGENT_MAX_TIER=0
TRINETRA_AGENT_AUTO_CLOSE=0
TRINETRA_AGENT_ENGINE=local
TRINETRA_SOC_INLINE=1
TRINETRA_DATABASE_URL=
TRINETRA_SOC_REDIS_URL=

# Reserved for automated fixture tests.
TRINETRA_ENABLE_FIXTURES=0
